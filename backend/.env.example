# ---------- App ----------
APP_NAME="Candidate Search"
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api

# ---------- MongoDB ----------
# Atlas SRV connection string for Cluster0
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Read-only source of candidate data (existing, untouched)
MONGO_DB_ATS=ats
PROFILES_COLLECTION=profiles
# This application's own database (users, sessions). Created on first run.
MONGO_DB_APP=search_and_retrieval

# ---------- Vector search ----------
VECTOR_INDEX_NAME=autoembed_index
# IMPORTANT: must be "document". See README "Vector index" section.
VECTOR_PATH=document
SEARCH_POOL_SIZE=100
SEARCH_MAX_POOL_SIZE=500
SEARCH_ANN_NUM_CANDIDATES_MULTIPLIER=15
SEARCH_SNIPPET_CHARS=1200

# ---------- Auth / JWT ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ALGORITHM=HS256
# Single stateless access token. No refresh - everyone signs in again daily.
ACCESS_TOKEN_TTL_HOURS=24

# ---------- Auth transport ----------
# Decides how the browser carries the session. See README "Choosing a transport".
#
# cookie -> httpOnly cookies only. Requires a same-site deployment: one origin
#           behind a proxy (app.ikrux.com + app.ikrux.com/api), or sibling
#           subdomains of one registrable domain (app.ikrux.com + api.ikrux.com).
#           Safest option - tokens never reach JavaScript.
# bearer -> Authorization: Bearer headers, tokens returned in the login body.
#           Use when the frontend is on an unrelated domain, where browsers block
#           third-party cookies no matter what SameSite says.
# both   -> accept either. Useful while the domain question is still open.
AUTH_TRANSPORT=cookie

# ---------- Cookies ----------
# Only used when AUTH_TRANSPORT is cookie or both.
# COOKIE_SAMESITE=strict works for same-origin AND sibling subdomains.
# COOKIE_SAMESITE=none is for cross-site; it requires COOKIE_SECURE=true and a
# populated CORS_ORIGINS, and modern browsers may still block the cookie.
# COOKIE_DOMAIN=.ikrux.com  <- set this when using sibling subdomains
# COOKIE_SECURE=false only for local http development
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=
CSRF_ENABLED=true

# ---------- Sign-in codes ----------
# There are no passwords. Signing in means receiving a numeric code by email.
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
# Local development escape hatch: with Graph unconfigured, write the code to the
# logs instead of mailing it. Refused when ENVIRONMENT=production.
OTP_LOG_CODE_WHEN_MAIL_UNCONFIGURED=false

# Per-IP ceiling on sign-in traffic
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ---------- Microsoft Graph (sends the sign-in codes) ----------
# Entra ID app registration with the *application* permission Mail.Send,
# granted admin consent. See README "Microsoft Graph setup".
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_SENDER="service@ikrux.com"
GRAPH_TIMEOUT_SECONDS=15

# ---------- MinIO (original resume PDFs) ----------
MINIO_ENDPOINT="objectstore.e2enetworks.net"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="resumes"
MINIO_SECURE=true
MINIO_PREFIX=""
MINIO_PRESIGN_EXPIRY_SECONDS=300

# ---------- CORS ----------
# Leave empty when frontend and API are served from the same origin behind one proxy.
CORS_ORIGINS=""
