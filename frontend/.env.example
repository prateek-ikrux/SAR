# Where the Candidate Search API lives.
#
# Required - this app has no default and will refuse to start without it.
# The value is read by the browser, so it has to be a URL the browser can reach,
# and it must include the API's /api prefix.
#
# It is inlined into the bundle at build time, not read at run time, so changing
# it means rebuilding rather than restarting.
VITE_API_BASE_URL=http://localhost:8000/api
